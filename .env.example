# Copy to `.env.local` and adjust. Files matching *.local are git-ignored.
#
# Only variables prefixed with VITE_ reach the browser, and EVERYTHING here is
# public once built. Never put secrets, private API keys or service-role
# credentials in these files; keep them on your backend.

# Display name used in the logo, document titles and footer.
# "Dapita" is the brand name (chosen 21 Oct 2026, see docs/implementation-plan.md §13.9).
VITE_APP_NAME=Dapita

# Base URL for the typed API client (src/lib/api-client.ts).
# A relative path works with a dev proxy or same-origin deployment.
VITE_API_BASE_URL=/api

# "true" (default): services return in-browser mock data and no requests are made.
# "false": services call VITE_API_BASE_URL through the API client. Run the AdonisJS
# API in server/ (see server/README.md); Vite proxies /api to it on port 3333.
VITE_USE_MOCKS=true

# TEMPORARY: "true" adds the design tweaks panel (colours, radius, display font) to a
# build, e.g. a stakeholder preview. It is always on in `npm run dev`. Never set it for
# production; the panel is removed once the design is signed off.
# VITE_DESIGN_TWEAKS=true
