# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (PostgreSQL). Create the tables and demo data with: npm run db:reset
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=dapita

# The Vite dev server, used in the links the server logs instead of emailing
FRONTEND_URL=http://localhost:5173

# Shop photos. The folder defaults to storage/uploads (relative to server/), and
# public URLs to /api/uploads. Set the URL when another origin serves the files.
# UPLOADS_DIR=storage/uploads
# UPLOADS_PUBLIC_URL=https://cdn.example.com/uploads

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000